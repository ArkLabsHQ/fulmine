# Fulmine overrides for the arkade-regtest stack (see docs/regtest.md).
# regtest.mjs reads arkade-regtest/.env.defaults first, then this file, then process env.

# Build-under-test: run THIS repo's image (built by `make regtest-build` as fulmine:e2e)
# instead of the published default.
FULMINE_IMAGE=fulmine:e2e

BOLTZ_IMAGE=ghcr.io/louisinger/boltz-backend:covclaim 

# Zero arkd intent fees. The stack defaults to `amount * 0.01` per intent, but the
# go-sdk version the e2e suite uses registers intents with no fee, so arkd rejects
# every settle/claim with INTENT_INSUFFICIENT_FEE. That blocks delegate
# registration AND the user-side claim that finalises a chain/submarine swap, so
# swaps sit forever in "pending". Fees aren't what these tests exercise.
ARK_OFFCHAIN_INPUT_FEE=0.0
ARK_ONCHAIN_INPUT_FEE=0.0
ARK_OFFCHAIN_OUTPUT_FEE=0.0
ARK_ONCHAIN_OUTPUT_FEE=0.0
